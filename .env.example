# Cookies from ads.telegram.org — never paste these into chat.
# Chrome/Edge (Windows): F12 or Ctrl+Shift+I → Application → Cookies → https://ads.telegram.org
# Copy stel_token / stel_ssid into the keys below. Then reload_session (MCP), not log_out.
STEL_TOKEN=
STEL_SSID=

# Optional — pre-select a cabinet. Otherwise the first non-"new" account is used.
# STEL_ADOWNER=

# Write permission for MCP tools. Default: confirm
#   strict  — every WRITE/DEST needs confirm=true (reads + reload_session still free)
#   confirm — pause / CPM / on_hold create (budget 0) free; spend, review, activate,
#             funds add/transfer/withdraw, delete, log_out, revoke, IP whitelist
#             need confirm=true
#   open    — trust writes. Stars still refused. Cookies still only in this file.
# TG_ADS_WRITE_GATE=confirm

# Optional — tool loading. eager (default): every tool at start. lazy: session/cabinet tools,
# get_ads, get_ad_stats and tg_ads_enable_toolsets (~1.7k vs ~7.3k startup tokens); other
# toolsets are added on demand via tools/list_changed. Keep eager if your client ignores it.
# TG_ADS_TOOL_LOADING=eager

# Optional — where preview_ad writes PNG files (default: ./previews)
# TG_ADS_PREVIEW_DIR=previews

# Optional — turn off the suggest-only GitHub release check (check_update).
# Unless disabled, the server calls api.github.com (anonymous, at most daily) at
# startup — relevant for HTTP/server deployments and firewalled hosts.
# TG_ADS_DISABLE_UPDATE_CHECK=1

# Optional — stdio (default) or streamable-http
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
