# Cookies from ads.telegram.org — never paste these into chat.
# DevTools → Application → Cookies → https://ads.telegram.org
STEL_TOKEN=
STEL_SSID=

# Optional — pre-select a cabinet. Otherwise the first non-"new" account is used.
# STEL_ADOWNER=

# Optional — where preview_ad writes PNG files (default: ./previews)
# TG_ADS_PREVIEW_DIR=previews

# Optional — stdio (default) or streamable-http
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
